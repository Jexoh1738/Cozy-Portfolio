<div class="flex flex-col gap-3">
    <h3 class="font-display text-base font-bold">Leave a review</h3>

    <div class="flex items-center gap-3">
        <StarRating @bind-Value="rating" Size="24" />
        @if (rating > 0)
        {
            <span class="text-xs text-bark/60">@Labels[rating]</span>
        }
    </div>

    <input type="text" placeholder="Your name (optional)" @bind="author" @bind:event="oninput"
           class="glass-input w-full rounded-full px-4 py-2.5 text-sm placeholder:text-bark/40 focus:outline-none" />

    <div class="relative">
        <textarea rows="3" placeholder="Share your thoughts on this album..." @bind="comment" @bind:event="oninput"
                  class="glass-input w-full resize-none rounded-2xl px-4 pt-3 pb-12 text-sm placeholder:text-bark/40 focus:outline-none"></textarea>
        <button type="button" @onclick="Post" disabled="@(!CanPost)"
                class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded-full px-3.5 py-1.5 font-display text-xs font-bold transition-all duration-150 @(CanPost
                    ? "cursor-pointer border border-[#ff6464]/60 bg-linear-to-b from-[#ff8282] to-[#f05050] text-white shadow-[0_3px_12px_rgba(248,113,113,0.5),inset_0_1px_0_rgba(255,200,200,0.6)] hover:brightness-105 active:scale-95"
                    : "cursor-not-allowed border border-white/50 bg-[#c8beb9]/35 text-bark/45")">
            <Icon Name="IconName.Send" Size="11" /> Post
        </button>
    </div>
</div>

<div class="glass-divider"></div>

<div class="flex flex-col gap-4">
    <h3 class="font-display text-base font-bold">
        Reviews <span class="font-body text-sm font-normal text-bark/40">(@Reviews.Count)</span>
    </h3>

    @if (Reviews.Count == 0)
    {
        <p class="text-sm text-bark/60">No reviews yet. Be the first to leave one!</p>
    }
    else
    {
        <div class="flex flex-col gap-3">
            @foreach (var review in Reviews)
            {
                <div @key="review.Id" class="glass-card flex flex-col gap-2 rounded-2xl p-4 motion-safe:animate-fade-up">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/55 font-display text-[11px] font-bold text-white"
                                 style="background: @Album.GlowColor; box-shadow: 0 2px 6px @Album.GlowColor;">
                                @char.ToUpperInvariant(review.Author[0])
                            </div>
                            <span class="font-display text-sm font-bold">@review.Author</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <StarRating Value="review.Rating" ReadOnly="true" Size="13" />
                            <span class="text-xs text-bark/40">@review.PostedAt.ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                    <p class="pl-9 text-sm leading-relaxed text-bark">@review.Comment</p>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Album Album { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Review> Reviews { get; set; } = Array.Empty<Review>();
    [Parameter] public EventCallback<ReviewDraft> OnSubmit { get; set; }

    private static readonly string[] Labels = ["", "Not for me", "It's ok", "Pretty good", "Really good", "Essential"];

    private int rating;
    private string author = "";
    private string comment = "";

    private bool CanPost => rating > 0 && !string.IsNullOrWhiteSpace(comment);

    private async Task Post()
    {
        if (!CanPost) return;
        await OnSubmit.InvokeAsync(new ReviewDraft(author, rating, comment));
        rating = 0;
        comment = "";
        author = "";
    }
}