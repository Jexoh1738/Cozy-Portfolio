<div class="fixed inset-0 z-[200] flex items-center justify-center p-4 sm:p-8" role="dialog" aria-modal="true" aria-label="@Album.Title">
    <!-- Backdrop is a sibling of the panel, so clicks inside the panel never reach it -->
    <div class="absolute inset-0 bg-[rgba(20,32,48,0.5)] backdrop-blur-lg backdrop-saturate-150" @onclick="() => OnClose.InvokeAsync()"></div>

    <div class="glass-panel relative flex max-h-[90dvh] w-full max-w-2xl flex-col overflow-hidden rounded-[2rem] motion-safe:animate-pop">
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-1/2 rounded-t-[2rem] bg-linear-to-b from-white/40 to-transparent"></div>

        <button type="button" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"
                class="absolute top-4 right-4 z-10 flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-white/75 bg-white/55 text-bark shadow-[0_2px_8px_rgba(0,0,0,0.1),inset_0_1px_0_rgba(255,255,255,0.8)] backdrop-blur-sm transition-all duration-150 hover:scale-110 hover:bg-white/80">
            <Icon Name="IconName.Close" Size="14" />
        </button>

        <div class="relative flex flex-col gap-6 overflow-y-auto p-6 sm:p-8">
            <div class="flex flex-col items-start gap-6 sm:flex-row">
                <div class="w-full shrink-0 sm:w-44">
                    <AlbumCover Album="Album">
                        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-4">
                            <span class="text-white/30 drop-shadow"><Icon Name="IconName.Disc" Size="52" /></span>
                            <div class="mt-1 text-center">
                                <p class="font-display text-lg leading-tight font-extrabold text-white/85 drop-shadow">@Album.Title</p>
                                <p class="text-sm font-semibold text-white/60">@Album.Artist</p>
                            </div>
                        </div>
                    </AlbumCover>
                </div>

                <div class="flex min-w-0 flex-1 flex-col gap-3 pt-1">
                    <div>
                        <p class="mb-1 text-xs font-bold tracking-widest text-bark/60 uppercase">@Album.Genre</p>
                        <h2 class="font-display text-2xl leading-tight font-extrabold">@Album.Title</h2>
                        <p class="text-base text-bark">@Album.Artist · @Album.Year</p>
                    </div>

                    @if (Reviews.Count > 0)
                    {
                        <div class="flex flex-col gap-1">
                            <StarRating Value="AverageStars" ReadOnly="true" Size="18" />
                            <p class="text-xs text-bark/60">@Reviews.Count review@(Reviews.Count == 1 ? "" : "s") · avg @(Average.ToString("0.0"))/5</p>
                        </div>
                    }

                    <div class="glass-card rounded-full px-4 py-2.5 text-xs text-[#8b7060] italic">
                        What does this album make you feel?
                    </div>
                </div>
            </div>

            <div class="glass-divider"></div>

            <ReviewSection Album="Album" Reviews="Reviews" OnSubmit="OnSubmit" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Album Album { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Review> Reviews { get; set; } = Array.Empty<Review>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ReviewDraft> OnSubmit { get; set; }

    private double Average => Reviews.Count == 0 ? 0 : Reviews.Average(r => r.Rating);
    private int AverageStars => (int)Math.Round(Average);
}