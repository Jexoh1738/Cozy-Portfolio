<div class="relative aspect-square w-full overflow-hidden rounded-2xl border-[1.5px] border-white/70 @Class"
     style="box-shadow: 0 4px 16px @Album.GlowColor, inset 0 1px 0 rgba(255,255,255,0.8);">
    <img src="@Album.CoverImagePath" alt="@Album.Title cover art" class="absolute inset-0 h-full w-full object-cover" />
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public Album Album { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}