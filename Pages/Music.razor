@page "/music"

<section>
    <SectionHeader Eyebrow="🎧 HEAVY ROTATION" EyebrowColor="var(--color-coral)" Title="Music Vault" />
    <p class="-mt-4 mb-8 max-w-md text-sm text-bark">
        Albums I keep returning to. Click any cover to read reviews or leave your own.
    </p>

    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
        @foreach (var album in albums)
        {
            <AlbumCard @key="album.Id" Album="album" OnSelect="() => Open(album)" />
        }
    </div>
</section>

@if (selected is not null)
{
    <AlbumModal Album="selected"
                Reviews="DataService.GetReviews(selected.Id)"
                OnClose="Close"
                OnSubmit="SubmitReview" />
}

@code {
    [Inject] private IPortfolioDataService DataService { get; set; } = default!;

    private IReadOnlyList<Album> albums = Array.Empty<Album>();
    private Album? selected;

    protected override void OnInitialized()
    {
        albums = DataService.GetAlbums();
    }

    private void Open(Album album) => selected = album;

    private void Close() => selected = null;

    private void SubmitReview(ReviewDraft draft)
    {
        if (selected is null) return;
        DataService.AddReview(selected.Id, draft.Author, draft.Rating, draft.Comment);
    }
}